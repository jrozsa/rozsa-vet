---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  backgroundImage?: ImageMetadata;
}

const { eyebrow, title, text, backgroundImage } = Astro.props;
---

<section class:list={["page-hero", backgroundImage && "has-image"]}>
  {
    backgroundImage && (
      <Image
        class="page-hero-bg"
        src={backgroundImage}
        alt=""
        aria-hidden="true"
        loading="eager"
      />
    )
  }
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p>{text}</p>
  </div>
</section>
