---
import { withBase } from "@/lib/urls";

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  backgroundImage?: string;
}

const { eyebrow, title, text, backgroundImage } = Astro.props;
const style = backgroundImage
  ? `--hero-image: url('${withBase(backgroundImage)}')`
  : undefined;
---

<section class:list={["page-hero", backgroundImage && "has-image"]} style={style}>
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p>{text}</p>
  </div>
</section>
