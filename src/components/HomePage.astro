---
import PageHero from "@/components/PageHero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { clinic, copy, pages, routes, whyReasons, type Lang } from "@/content/site";
import { withBase } from "@/lib/urls";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const path = routes[lang].home;
const reasons = whyReasons[lang];
---

<BaseLayout lang={lang} page="home" path={path}>
  <PageHero
    eyebrow={t.heroEyebrow}
    title={t.heroTitle}
    text={t.heroText}
    backgroundImage="/assets/hero-dog.jpg"
  />

  <section class="why-us section" aria-labelledby="why-us-title">
    <div class="container why-us-inner">
      <header class="why-us-header">
        <p class="eyebrow">{t.whyEyebrow}</p>
        <h2 id="why-us-title">{t.whyTitle}</h2>
        <p class="why-us-intro">{t.whyIntro}</p>
      </header>

      <div class="why-us-story">
        <div class="why-us-year">
          <span class="why-us-year-value">{clinic.founded}</span>
          <span class="why-us-year-label">{t.whyYearLabel}</span>
        </div>
        <p class="why-us-history">{t.whyHistory}</p>
      </div>

      <ol class="why-us-reasons">
        {reasons.map((reason, index) => (
          <li class="why-us-reason">
            <span class="why-us-index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{reason.title}</h3>
            <p>{reason.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="services-cta">
        <h2>{pages[lang].services.title}</h2>
        <p>{pages[lang].services.description}</p>
        <a class="button teal" href={withBase(routes[lang].services)}>{t.allServices}</a>
      </div>
    </div>
  </section>
</BaseLayout>
