---
import { clinic, copy, type Lang } from "@/content/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<div class="quick-actions">
  <a class="button teal" href={`tel:${clinic.mobile}`}>{t.call}</a>
  <a class="button" href={`mailto:${clinic.email}`}>{t.email}</a>
  <a class="button" href={clinic.mapUrl} target="_blank" rel="noreferrer">{t.navigate}</a>
</div>
